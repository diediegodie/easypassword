# EasyPassword .env.example (for local dev and CI)
# Copy this file to .env and fill in secrets as needed.

# ===== DATABASE =====
DB_USER=easypassword_user
DB_PASSWORD=dev_password
DB_NAME=easypassword

# ===== APPLICATION =====
APP_ENV=development
SECRET_KEY=dev_secret_key
DEBUG=true

# ===== FRONTEND =====
NODE_ENV=development

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ===== POSTGRES =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://easypassword_user:dev_password@postgres:5432/easypassword

# ===== BACKEND CONFIGURATION =====
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7
WEBAUTHN_CHALLENGE_TTL_SECONDS=90
WEBAUTHN_RP_NAME=EasyPassword
CLOCK_SKEW_TOLERANCE_SECONDS=120
INACTIVITY_TIMEOUT_SECONDS=60

# ===== BACKEND REQUIRED VARS =====
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000
