# EasyPassword .env.example (for local dev and CI)
# Copy this file to .env and fill in secrets as needed.

# ===== BANCO DE DADOS =====
DB_USER=easypassword_user
DB_PASSWORD=dev_password
DB_NAME=easypassword

# ===== APLICACAO =====
APP_ENV=development
SECRET_KEY=dev_secret_key
DEBUG=true

# ===== FRONTEND =====
NODE_ENV=development

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ===== POSTGRES =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://easypassword_user:dev_password@postgres:5432/easypassword

# ===== BACKEND REQUIRED VARS =====
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000
