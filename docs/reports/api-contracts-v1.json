            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RegistrationCompletionRequest": {
        "properties": {
          "registration_id": {
            "type": "string",
            "title": "Registration Id",
            "description": "The registration_id returned from initiation endpoint"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object",
            "title": "Credential",
            "description": "Full attestation payload from navigator.credentials.create()"
          }
        },
        "type": "object",
        "required": [
          "registration_id",
          "credential"
        ],
        "title": "RegistrationCompletionRequest",
        "description": "Request schema for WebAuthn registration completion."
      },
      "RegistrationCompletionResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Device Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
