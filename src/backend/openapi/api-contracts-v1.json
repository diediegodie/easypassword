        ],
        "title": "AuthenticationInitiationRequest",
        "description": "Request schema for WebAuthn authentication initiation."
      },
      "AuthenticationInitiationResponse": {
        "properties": {
          "authentication_id": {
            "type": "string",
            "title": "Authentication Id",
            "description": "Server-generated unique identifier for this authentication session"
          },
          "public_key": {
            "additionalProperties": true,
            "type": "object",
            "title": "Public Key",
            "description": "WebAuthn authentication options for navigator.credentials.get()"
          }
        },
        "type": "object",
        "required": [
          "authentication_id",
          "public_key"
        ],
        "title": "AuthenticationInitiationResponse",
        "description": "Response schema for WebAuthn authentication initiation."
      },
