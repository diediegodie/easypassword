                  "code": "ReauthenticationRequired",
                  "message": "Reauthentication required"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error - request violated the Phase 3.1 contract (e.g., extra fields, suspicious key names, invalid blob, blob too large, unsupported blob version).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "extraFields": {
                    "summary": "Extra fields rejected",
                    "value": {
                      "code": "ERR_EXTRA_FIELDS",
                      "message": "Unknown fields are not allowed",
                      "details": {
                        "fields": ["plaintext_password"]
                      }
                    }
                  },
                  "suspiciousKey": {
                    "summary": "Plaintext-looking field rejected",
                    "value": {
                      "code": "ERR_SUSPICIOUS_KEY",
                      "message": "Field name suggests plaintext credential; client-side encryption required",
                      "details": {
                        "field": "password"
                      }
                    }
                  },
                  "invalidBlob": {
                    "summary": "Invalid blob format",
                    "value": {
                      "code": "ERR_INVALID_BLOB",
                      "message": "Blob is not valid base64 or does not match the expected layout"
                    }
                  },
                  "blobTooLarge": {
                    "summary": "Blob exceeds size limit",
                    "value": {
                      "code": "ERR_BLOB_TOO_LARGE",
                      "message": "Blob exceeds the maximum allowed size of 1048576 bytes"
                    }
                  },
                  "unsupportedVersion": {
                    "summary": "Unsupported blob version",
                    "value": {
                      "code": "ERR_UNSUPPORTED_BLOB_VERSION",
                      "message": "Blob version 2 is not supported by this server"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
