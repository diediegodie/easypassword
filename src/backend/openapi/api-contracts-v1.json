    "/api/v1/auth/register/options": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register Options",
        "description": "Initiate WebAuthn registration for a new device.\n\nThis endpoint generates WebAuthn registration options and stores a challenge\nin Redis for one-time consumption during verification. If the user doesn't exist,\nthey will be created. If the user already has an active device, a 409 Conflict\nis returned (single-device policy).\n\nReturns:\n    registration_id: Unique identifier for this registration session\n    public_key: WebAuthn registration options for navigator.credentials.create()",
        "operationId": "register_options_api_v1_auth_register_options_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationInitiationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationInitiationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed or reauthentication required.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Reauthentication required",
                  "code": "ReauthenticationRequired"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
