  "components": {
    "schemas": {
      "AuthenticationCompletionRequest": {
        "properties": {
          "authentication_id": {
            "type": "string",
            "title": "Authentication Id",
            "description": "The authentication_id returned from initiation endpoint"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object",
            "title": "Credential",
            "description": "Full assertion payload from navigator.credentials.get()"
          }
        },
        "type": "object",
        "required": [
          "authentication_id",
          "credential"
        ],
        "title": "AuthenticationCompletionRequest",
        "description": "Request schema for WebAuthn authentication completion."
      },
      "AuthenticationCompletionResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Device Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "device_id",
          "user_id"
        ],
        "title": "AuthenticationCompletionResponse",
        "description": "Response schema for WebAuthn authentication completion."
