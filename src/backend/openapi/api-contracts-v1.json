        ],
        "summary": "Login Verify",
        "description": "Complete WebAuthn authentication and issue session tokens.\n\nThe challenge is consumed one-time from Redis. After successful verification,\nan access token is returned and a refresh token cookie is set.",
        "operationId": "login_verify_api_v1_auth_login_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationCompletionRequest"
